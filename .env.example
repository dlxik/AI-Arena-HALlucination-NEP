GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=15000

# Image generation is optional; leave blank for an explicit not_configured fallback.
# Set both IMAGE_PROVIDER=gemini and an image-capable model available to your key.
IMAGE_PROVIDER=
GEMINI_IMAGE_MODEL=
# e.g. gemini-3.1-flash-image; independent of the text model above.
GEMINI_IMAGE_TIMEOUT_MS=60000
