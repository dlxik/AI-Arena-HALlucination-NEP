# LLM Provider: 'fpt' (FPT AI Factory) hoặc 'gemini'
LLM_PROVIDER=gemini
FPT_API_KEY=
FPT_BASE_URL=https://mkp-api.fptcloud.com/v1
FPT_MODEL=Qwen3.6-27B
FPT_TIMEOUT_MS=60000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=15000

# Image generation: 'pollinations' (miễn phí không cần key) hoặc 'gemini'
IMAGE_PROVIDER=pollinations
GEMINI_IMAGE_MODEL=
# e.g. gemini-3.1-flash-image khi dùng IMAGE_PROVIDER=gemini
GEMINI_IMAGE_TIMEOUT_MS=60000

